{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openstore.dev/themes/base/tokens.schema.json",
  "title": "base 主题 token：默认值 + 可编辑白名单 + admin 表单源（单一真源）",
  "description": "单一真源（架构 §5.1.2 / 决策 D-2 / 裁决 W5）：默认值与可编辑白名单在同一个文件里，因此不存在『商家看到的默认色 ≠ 实际渲染的默认色』这类无人会主动发现的漂移。每个属性必须是自包含 schema（不许外部 $ref），因为 admin 只读这一个 JSON 文件来渲染编辑表单。properties 的每个键都必须带 default —— 缺 default 报 TOKEN_DEFAULT_MISSING。",
  "type": "object",
  "propertyNames": { "$ref": "#/$defs/tokenKey" },
  "additionalProperties": false,
  "properties": {
    "color.bg": {
      "type": "string",
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
      "default": "#ffffff",
      "x-control": "color",
      "x-group": "颜色",
      "description": "页面底色。"
    },
    "color.fg": {
      "type": "string",
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
      "default": "#111827",
      "x-control": "color",
      "x-group": "颜色",
      "x-a11y": [{ "fg": "color.fg", "bg": "color.bg", "min": 4.5 }],
      "description": "正文前景色，与 color.bg 需满足 WCAG AA。"
    },
    "color.primary": {
      "type": "string",
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
      "default": "#2563eb",
      "x-control": "color",
      "x-group": "颜色",
      "description": "主色：按钮、链接、选中态。"
    },
    "color.muted": {
      "type": "string",
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
      "default": "#6b7280",
      "x-control": "color",
      "x-group": "颜色",
      "description": "次要文字（副标题、辅助信息）。"
    },
    "color.border": {
      "type": "string",
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
      "default": "#e5e7eb",
      "x-control": "color",
      "x-group": "颜色",
      "description": "分隔线与边框。"
    },
    "font.sans": {
      "type": "string",
      "minLength": 1,
      "default": "Inter, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "x-control": "font",
      "x-group": "字体",
      "description": "正文字体栈。必须是完整 CSS font-family 值，自托管字体优先。"
    },
    "radius.md": {
      "type": "string",
      "pattern": "^[0-9]+(px|rem)$",
      "default": "8px",
      "x-control": "length",
      "x-group": "圆角",
      "description": "中号圆角（卡片、输入框）。"
    },
    "space.md": {
      "type": "string",
      "pattern": "^[0-9]+(px|rem)$",
      "default": "16px",
      "x-control": "length",
      "x-group": "间距",
      "description": "中号间距，区块内元素纵向间距基准。"
    }
  },
  "$defs": {
    "tokenKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+)+$",
      "description": "token 键必须是扁平点分小写（color.primary → CSS 变量 --color-primary）。"
    }
  }
}
