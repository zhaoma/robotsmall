{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openstore.dev/themes/base/editable.schema.json",
  "title": "base 主题可编辑白名单",
  "description": "既是 token 值的校验器（把 tokens.json 或商家覆盖值直接喂给本 schema），也是 admin 编辑表单的数据源（x-control 决定控件、x-group 决定分组），同时用 $defs.blockKey 声明首页区块白名单。properties 的键集必须与 tokens.json 的键集完全相同（check-themes 的 TOKEN_KEY_MISMATCH）。",
  "type": "object",
  "propertyNames": { "$ref": "#/$defs/tokenKey" },
  "additionalProperties": false,
  "properties": {
    "color.bg": {
      "type": "string",
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
      "x-control": "color",
      "x-group": "颜色",
      "description": "页面底色。"
    },
    "color.fg": {
      "type": "string",
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
      "x-control": "color",
      "x-group": "颜色",
      "x-a11y": [{ "fg": "color.fg", "bg": "color.bg", "min": 4.5 }],
      "description": "正文前景色，与 color.bg 需满足 WCAG AA。"
    },
    "color.primary": {
      "type": "string",
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
      "x-control": "color",
      "x-group": "颜色",
      "description": "主色：按钮、链接、选中态。"
    },
    "color.muted": {
      "type": "string",
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
      "x-control": "color",
      "x-group": "颜色",
      "description": "次要文字（副标题、辅助信息）。"
    },
    "color.border": {
      "type": "string",
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
      "x-control": "color",
      "x-group": "颜色",
      "description": "分隔线与边框。"
    },
    "font.sans": {
      "type": "string",
      "minLength": 1,
      "x-control": "font",
      "x-group": "字体",
      "description": "正文字体栈。必须是完整 CSS font-family 值，自托管字体优先。"
    },
    "radius.md": {
      "type": "string",
      "pattern": "^[0-9]+(px|rem)$",
      "x-control": "length",
      "x-group": "圆角",
      "description": "中号圆角（卡片、输入框）。"
    },
    "space.md": {
      "type": "string",
      "pattern": "^[0-9]+(px|rem)$",
      "x-control": "length",
      "x-group": "间距",
      "description": "中号间距，区块内元素纵向间距基准。"
    }
  },
  "$defs": {
    "tokenKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+)+$",
      "description": "token 键必须是扁平点分小写（color.primary → CSS 变量 --color-primary）。"
    },
    "blockKey": {
      "type": "string",
      "enum": ["hero", "productGrid", "richText", "footer"],
      "description": "本主题提供的首页区块白名单：manifest.blocks[] 的每一项都必须在这里。新增区块 = 这里加一项 + 加组件 + 加 blocks.schema.json 一节。"
    }
  }
}
